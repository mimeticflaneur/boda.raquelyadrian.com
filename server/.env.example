# Copia este fichero a `.env` y ajusta los valores.
# El backend lee estas variables del entorno (no carga el .env por si solo;
# usa `docker compose`, tu panel de hosting, o `export VAR=...` antes de arrancar).

# Puerto en el que escucha el servidor
PORT=3000

# Interfaz de escucha (0.0.0.0 = todas)
HOST=0.0.0.0

# Token secreto para entrar al panel /admin y descargar los CSV.
# CAMBIALO por una cadena larga y aleatoria.
ADMIN_TOKEN=pon-aqui-un-token-largo-y-secreto

# Origen permitido para las peticiones del navegador (CORS).
# Si el frontend (GitHub Pages) y el backend estan en dominios distintos,
# pon aqui la URL EXACTA del sitio, p. ej.: https://raquelyadrian.com
# Usa * solo para pruebas.
ALLOW_ORIGIN=*

# Carpeta donde se guardan los datos (rsvp.ndjson y canciones.ndjson).
# En Docker conviene montarla como volumen para que persista.
DATA_DIR=./data
